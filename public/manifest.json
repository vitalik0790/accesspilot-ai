{
  "manifest_version": 3,
  "name": "AccessPilot AI",
  "version": "0.2.0",
  "description": "On-demand page summaries, questions, speech, and basic accessibility checks.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Open AccessPilot AI" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open AccessPilot AI"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.openai.com"
  }
}
