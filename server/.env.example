# Copy to server/.env.local. Never put this file under public/ or dist/.
NODE_ENV=development
AUTH_MODE=development
PORT=8787
# Copy the ID from chrome://extensions (32 letters a-p).
EXTENSION_ORIGIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=25000
DEV_PLAN=free
# Illustrative LOCAL TEST limits only, NOT product quotas or pricing.
FREE_MONTHLY_REQUESTS=20
FREE_REQUESTS_PER_MINUTE=5
PRO_MONTHLY_REQUESTS=100
PRO_REQUESTS_PER_MINUTE=10
